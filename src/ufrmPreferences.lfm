object frmPreferences: TfrmPreferences
  Left = 400
  Height = 490
  Top = 200
  Width = 400
  BorderStyle = bsDialog
  Caption = 'Preferences'
  ClientHeight = 490
  ClientWidth = 400
  Position = poOwnerFormCenter
  LCLVersion = '4.8.0.0'
  OnShow = FormShow
  object gbAppearance: TGroupBox
    Left = 10
    Height = 135
    Top = 10
    Width = 380
    Caption = 'Appearance'
    ClientHeight = 115
    ClientWidth = 376
    TabOrder = 0
    object lblTheme: TLabel
      Left = 15
      Height = 15
      Top = 15
      Width = 40
      Caption = 'Theme:'
    end
    object cbTheme: TComboBox
      Left = 120
      Height = 23
      Top = 11
      Width = 240
      ItemHeight = 15
      Items.Strings = (
        'Dark Mode (Visual Operator)'
        'Light Mode (Clean)'
      )
      Style = csDropDownList
      TabOrder = 0
    end
    object lblFontName: TLabel
      Left = 15
      Height = 15
      Top = 46
      Width = 62
      Caption = 'Font Name:'
    end
    object cbFontName: TComboBox
      Left = 120
      Height = 23
      Top = 42
      Width = 240
      ItemHeight = 15
      Style = csDropDownList
      TabOrder = 1
    end
    object lblFontSize: TLabel
      Left = 15
      Height = 15
      Top = 77
      Width = 50
      Caption = 'Font Size:'
    end
    object seFontSize: TSpinEdit
      Left = 120
      Height = 23
      Top = 73
      Width = 90
      MaxValue = 72
      MinValue = 8
      TabOrder = 2
      Value = 11
    end
  end
  object gbEditor: TGroupBox
    Left = 10
    Height = 135
    Top = 155
    Width = 380
    Caption = 'Editor Settings'
    ClientHeight = 115
    ClientWidth = 376
    TabOrder = 1
    object lblTabWidth: TLabel
      Left = 15
      Height = 15
      Top = 15
      Width = 57
      Caption = 'Tab Width:'
    end
    object seTabWidth: TSpinEdit
      Left = 120
      Height = 23
      Top = 11
      Width = 90
      MaxValue = 16
      MinValue = 1
      TabOrder = 0
      Value = 4
    end
    object lblLineEnding: TLabel
      Left = 15
      Height = 15
      Top = 46
      Width = 65
      Caption = 'Line Ending:'
    end
    object cbLineEnding: TComboBox
      Left = 120
      Height = 23
      Top = 42
      Width = 240
      ItemHeight = 15
      Items.Strings = (
        'CRLF (Windows)'
        'LF (Unix / macOS)'
      )
      Style = csDropDownList
      TabOrder = 1
    end
    object chkWordWrap: TCheckBox
      Left = 120
      Height = 19
      Top = 77
      Width = 78
      Caption = 'Word Wrap'
      TabOrder = 2
    end
  end
  object gbAI: TGroupBox
    Left = 10
    Height = 135
    Top = 300
    Width = 380
    Caption = 'AI Assistant Settings'
    ClientHeight = 115
    ClientWidth = 376
    TabOrder = 2
    object lblAIEngine: TLabel
      Left = 15
      Height = 15
      Top = 15
      Width = 53
      Caption = 'AI Engine:'
    end
    object cbAIEngine: TComboBox
      Left = 120
      Height = 23
      Top = 11
      Width = 240
      ItemHeight = 15
      Items.Strings = (
        'Local Llama (GGUF)'
        'Gemini Cloud API'
      )
      Style = csDropDownList
      TabOrder = 0
